# Telegram Configuration
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui
# IDs de usuários autorizados a usar /menu (separados por vírgula)
TELEGRAM_ADMIN_IDS=

# Google Gemini API
GEMINI_API_KEY=sua_api_key_aqui

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI / Codex (https://platform.openai.com)
OPENAI_API_KEY=

# Legacy — usado só se data/settings.json não existir ainda
GEMINI_MODEL=gemini-2.5-flash

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://api.suadominio.com
EVOLUTION_API_KEY=sua_apikey_aqui
EVOLUTION_API_INSTANCE=sua_instancia_aqui
WHATSAPP_NUMBER=5511999999999
